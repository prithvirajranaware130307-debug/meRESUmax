FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_secret_for_meresumax
DATABASE_URL=sqlite:///meresumax_dev.db

# Google Gemini AI Integration (Primary AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq API Integration (Fallback AI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Job Provider (JSearch Mega via RapidAPI)
RAPIDAPI_KEY=
JSEARCH_API_HOST=jsearch-mega.p.rapidapi.com

# Upload Limits
MAX_CONTENT_LENGTH=16777216
