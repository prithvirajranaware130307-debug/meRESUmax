FLASK_ENV=development
SECRET_KEY=replace_with_a_secure_random_secret_for_meresumax
DATABASE_URL=sqlite:///meresumax_dev.db

# Google Gemini AI Integration (Default)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI Integration (Alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# External Job Provider (Adzuna)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# Optional Secondary Provider (JSearch via RapidAPI)
RAPIDAPI_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Upload Limits
MAX_CONTENT_LENGTH=16777216
